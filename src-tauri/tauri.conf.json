{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Juice",
  "version": "0.1.12",
  "identifier": "com.pointi.agentjuice",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "url": "index.html",
        "title": "Juice",
        "width": 620,
        "height": 720,
        "minWidth": 480,
        "minHeight": 560,
        "decorations": false,
        "visible": false,
        "skipTaskbar": false,
        "alwaysOnTop": false,
        "resizable": true,
        "shadow": true
      },
      {
        "label": "bar-claude",
        "url": "bar.html?tool=claude",
        "title": "Juice Bar",
        "width": 260,
        "height": 40,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "transparent": true
      },
      {
        "label": "bar-codex",
        "url": "bar.html?tool=codex",
        "title": "Juice Bar",
        "width": 260,
        "height": 40,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "transparent": true
      },
      {
        "label": "bar-grok",
        "url": "bar.html?tool=grok",
        "title": "Juice Bar",
        "width": 260,
        "height": 40,
        "decorations": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1MEYxMTM3MzNDQ0FBNkEKUldScXFzd3pOeEVQMVpmeFQ3QmFvYjREbS9DQTI2N1AvYUgvVFA1V3d6MjhUOTFKVUs0d1FKOEwK",
      "endpoints": [
        "https://github.com/Lv2dev/agent-juice/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
